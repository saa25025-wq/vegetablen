        }

        function updateCropFilter() {
            const list = window.recordsData || [];
            const select = document.getElementById('filter-crop-select');
            const current = select.value;
            const crops = Array.from(new Set(list.map(r => r.crop)));

            select.innerHTML = '<option value="ALL">全作物</option>';
            crops.forEach(c => {
                const opt = document.createElement('option');
                opt.value = c; opt.innerText = c;
                select.appendChild(opt);
            });
            if (crops.includes(current)) select.value = current;
        }

        function renderPlantList() {
            const list = window.recordsData || [];
            const filterCrop = document.getElementById('filter-crop-select').value;
            const sortOrder = document.getElementById('p-sort').value;

            let filtered = [...list];
            if (filterCrop !== 'ALL') filtered = filtered.filter(r => r.crop === filterCrop);
            filtered.sort((a,b) => sortOrder==='NEWEST' ? new Date(b.date)-new Date(a.date) : new Date(a.date)-new Date(b.date));

            document.getElementById('record-num').innerText = filtered.length;
            const container = document.getElementById('p-list-container');

            if (filtered.length === 0) {
                container.innerHTML = '<p class="text-xs text-slate-400 text-center py-6">表示できる記録がありません。</p>';
                return;
