<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>農作物Web開発＆学習統合スイート (plantcheck & vegetable)</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Noto Sans JP"', '"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                            800: '#166534',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col">

    <!-- Top Navigation Header -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-600 to-green-400 flex items-center justify-center text-white shadow-md shadow-emerald-200">
                        <i class="fa-solid font-bold fa-seedling text-xl"></i>
                    </div>
                    <div>
                        <h1 class="font-bold text-slate-900 text-lg leading-tight">実技課題マスター開発スイート</h1>
                        <p class="text-xs text-slate-500">Firebase 生育管理 ＆ GitHub Pages 紹介サイト</p>
                    </div>
                </div>

                <!-- Navigation Tabs -->
                <nav class="hidden md:flex space-x-1 bg-slate-100 p-1 rounded-xl">
                    <button onclick="switchTab('tab-plantcheck')" id="btn-tab-plantcheck" class="tab-btn active px-4 py-2 rounded-lg text-sm font-medium transition-all duration-150 flex items-center space-x-2 bg-white text-emerald-700 shadow-sm">
                        <i class="fa-solid fa-chart-line"></i>
                        <span>1. 生育管理アプリ (plantcheck)</span>
                    </button>
                    <button onclick="switchTab('tab-vegetable')" id="btn-tab-vegetable" class="tab-btn px-4 py-2 rounded-lg text-sm font-medium transition-all duration-150 flex items-center space-x-2 text-slate-600 hover:text-slate-900">
                        <i class="fa-solid fa-carrot"></i>
                        <span>2. マイ作物紹介サイト (vegetable)</span>
                    </button>
                    <button onclick="switchTab('tab-submission')" id="btn-tab-submission" class="tab-btn px-4 py-2 rounded-lg text-sm font-medium transition-all duration-150 flex items-center space-x-2 text-slate-600 hover:text-slate-900">
                        <i class="fa-solid fa-clipboard-check"></i>
                        <span>3. 提出＆振り返りアシスタント</span>
                    </button>
                </nav>

                <div class="flex items-center space-x-2">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">
                        <span class="w-2 h-2 mr-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                        試験準備OK
                    </span>
                </div>
            </div>
        </div>

        <!-- Mobile Navigation Bar -->
        <div class="md:hidden border-t border-slate-200 bg-white px-2 py-2 flex justify-around text-xs">
            <button onclick="switchTab('tab-plantcheck')" id="m-btn-tab-plantcheck" class="m-tab-btn flex flex-col items-center p-2 text-emerald-600 font-bold">
                <i class="fa-solid fa-chart-line text-base mb-1"></i>
                <span>plantcheck</span>
            </button>
            <button onclick="switchTab('tab-vegetable')" id="m-btn-tab-vegetable" class="m-tab-btn flex flex-col items-center p-2 text-slate-500">
                <i class="fa-solid fa-carrot text-base mb-1"></i>
                <span>vegetable</span>
            </button>
            <button onclick="switchTab('tab-submission')" id="m-btn-tab-submission" class="m-tab-btn flex flex-col items-center p-2 text-slate-500">
                <i class="fa-solid fa-clipboard-check text-base mb-1"></i>
                <span>提出チェック</span>
            </button>
        </div>
    </header>

    <!-- Toast Notification Banner -->
    <div id="toast" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 bg-slate-900 text-white px-5 py-3 rounded-xl shadow-xl flex items-center space-x-3 border border-slate-700">
        <i id="toast-icon" class="fa-solid fa-circle-check text-emerald-400 text-lg"></i>
        <span id="toast-msg" class="text-sm font-medium">メッセージ</span>
    </div>

    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <!-- TAB 1: 生育管理アプリ (plantcheck) -->
        <section id="tab-plantcheck" class="tab-content space-y-6">
            
            <!-- Banner Header -->
            <div class="bg-gradient-to-r from-emerald-800 to-teal-700 rounded-2xl p-6 text-white shadow-lg relative overflow-hidden">
                <div class="relative z-10 max-w-3xl">
                    <div class="inline-flex items-center space-x-2 px-3 py-1 bg-white/10 backdrop-blur-md rounded-full text-xs text-emerald-200 mb-3 border border-white/20">
                        <i class="fa-solid fa-fire"></i> 課題1完全攻略：Firebase/Firestore + Hosting
                    </div>
                    <h2 class="text-2xl sm:text-3xl font-bold mb-2">作物の生育記録アプリ (plantcheck)</h2>
                    <p class="text-emerald-100 text-sm leading-relaxed mb-4">
                        5項目の入力・データの一覧表示・Firebase永続化・日付順ソート・作物絞り込み・草丈グラフ表示機能に対応しています。以下でそのまま記録の試行と、GitHubアップロード用のコード取得が可能です。
                    </p>
                    <div class="flex flex-wrap gap-2 text-xs">
                        <span class="bg-emerald-900/60 px-3 py-1 rounded-lg border border-emerald-500/30"><i class="fa-solid fa-check mr-1 text-emerald-400"></i>5項目入力・保存</span>
                        <span class="bg-emerald-900/60 px-3 py-1 rounded-lg border border-emerald-500/30"><i class="fa-solid fa-check mr-1 text-emerald-400"></i>一覧＆再読み込み保持</span>
                        <span class="bg-emerald-900/60 px-3 py-1 rounded-lg border border-emerald-500/30"><i class="fa-solid fa-check mr-1 text-emerald-400"></i>編集・削除・ソート</span>
                        <span class="bg-emerald-900/60 px-3 py-1 rounded-lg border border-emerald-500/30"><i class="fa-solid fa-check mr-1 text-emerald-400"></i>Chart.js 生育グラフ</span>
                    </div>
                </div>
            </div>

            <!-- Main App Interactive Area -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                
                <!-- Left Column: Input Form (5 Mandatory Items + Validation) -->
                <div class="lg:col-span-5 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
                    <div class="flex justify-between items-center pb-3 border-b border-slate-100">
                        <h3 class="font-bold text-slate-800 text-lg flex items-center">
                            <i class="fa-solid fa-pen-to-square text-emerald-600 mr-2"></i>
                            <span id="form-title">生育データの入力</span>
                        </h3>
                        <span class="text-xs text-rose-500 font-medium">* 全項目必須</span>
                    </div>

                    <!-- Error Alert Box -->
                    <div id="form-error" class="hidden p-3 bg-rose-50 border border-rose-200 text-rose-700 text-xs rounded-xl flex items-start space-x-2">
                        <i class="fa-solid fa-circle-exclamation mt-0.5 text-rose-500"></i>
                        <span id="form-error-msg">未入力または不適切な数値項目があります。</span>
                    </div>

                    <form id="plant-form" onsubmit="handleFormSubmit(event)" class="space-y-4">
                        <input type="hidden" id="edit-id" value="">

                        <!-- Item 1: Crop Name -->
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">
                                作物名 <span class="text-rose-500">*</span>
                            </label>
                            <input type="text" id="input-crop" placeholder="例: ミニトマト, キュウリ" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition">
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <!-- Item 2: Leaf Count -->
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1">
                                    葉枚数 (枚) <span class="text-rose-500">*</span>
                                </label>
                                <input type="number" id="input-leaves" min="0" placeholder="例: 8" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition">
                            </div>
                            <!-- Item 3: Plant Height -->
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1">
                                    草丈 (cm) <span class="text-rose-500">*</span>
                                </label>
                                <input type="number" step="0.1" id="input-height" min="0" placeholder="例: 24.5" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition">
                            </div>
                        </div>

                        <!-- Item 4: Date Picker -->
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">
                                日付 <span class="text-rose-500">*</span>
                            </label>
                            <input type="date" id="input-date" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition">
                        </div>

                        <!-- Item 5: Note (Multiline Text) -->
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">
                                メモ (複数行可) <span class="text-rose-500">*</span>
                            </label>
                            <textarea id="input-memo" rows="3" placeholder="追肥を実施。本葉の勢いが良く、第1花房が開花し始めている。" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition resize-none"></textarea>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="pt-2 flex space-x-2">
                            <button type="submit" id="btn-save" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-2.5 px-4 rounded-xl shadow-md shadow-emerald-200 transition flex items-center justify-center space-x-2">
                                <i class="fa-solid fa-floppy-disk"></i>
                                <span id="btn-save-text">記録を保存する</span>
                            </button>
                            <button type="button" id="btn-cancel" onclick="resetForm()" class="hidden bg-slate-200 hover:bg-slate-300 text-slate-700 font-medium py-2.5 px-4 rounded-xl transition">
                                キャンセル
                            </button>
                        </div>
                    </form>

                    <!-- Export Code Prompt Card -->
                    <div class="mt-6 pt-4 border-t border-slate-100 bg-emerald-50/50 p-4 rounded-xl border border-emerald-100">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-bold text-emerald-900 flex items-center">
                                <i class="fa-solid fa-code text-emerald-600 mr-1.5"></i> GitHub `plantcheck` 提出用コード
                            </span>
                        </div>
                        <p class="text-xs text-slate-600 mb-3">
                            この設定で動作する1ファイル完結型 `index.html` コードを生成・コピーしてGitHubにアップロードできます。
                        </p>
                        <button onclick="copyPlantcheckSingleCode()" class="w-full bg-white hover:bg-emerald-100 text-emerald-700 border border-emerald-300 font-medium py-2 px-3 rounded-lg text-xs transition flex items-center justify-center space-x-1">
                            <i class="fa-solid fa-copy"></i>
                            <span>完全版 index.html コードをコピー (Firebase: purant 設定済み)</span>
                        </button>
                    </div>
                </div>

                <!-- Right Column: Analytics Chart & Data Records List -->
                <div class="lg:col-span-7 space-y-6">
                    
                    <!-- Analytics Growth Chart -->
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                        <div class="flex justify-between items-center mb-3">
                            <h3 class="font-bold text-slate-800 text-sm flex items-center">
                                <i class="fa-solid fa-chart-line text-emerald-600 mr-2"></i>
                                生育成長グラフ (発展機能)
                            </h3>
                            <span class="text-xs text-slate-500" id="chart-subtitle">草丈 (cm) と 葉枚数 (枚) の推移</span>
                        </div>
                        <div class="h-48 w-full">
                            <canvas id="growthChart"></canvas>
                        </div>
                    </div>

                    <!-- Records Management List Section -->
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-4">
                        
                        <!-- Search & Filter Controls (Advanced Features) -->
                        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 pb-3 border-b border-slate-100">
                            <div>
                                <h3 class="font-bold text-slate-800 text-base flex items-center">
                                    <i class="fa-solid fa-list-check text-emerald-600 mr-2"></i>
                                    登録済み生育記録一覧
                                </h3>
                                <p class="text-xs text-slate-500">件数: <span id="record-count" class="font-bold text-emerald-600">0</span> 件</p>
                            </div>

                            <!-- Filter Controls -->
                            <div class="flex items-center space-x-2 w-full sm:w-auto">
                                <!-- Crop Filter Dropdown -->
                                <select id="filter-crop" onchange="renderRecords()" class="px-2.5 py-1.5 bg-slate-50 border border-slate-200 text-xs rounded-lg text-slate-700 focus:outline-none focus:ring-1 focus:ring-emerald-500">
                                    <option value="ALL">すべての作物</option>
                                </select>
                                <!-- Date Sort Toggle -->
                                <select id="sort-order" onchange="renderRecords()" class="px-2.5 py-1.5 bg-slate-50 border border-slate-200 text-xs rounded-lg text-slate-700 focus:outline-none focus:ring-1 focus:ring-emerald-500">
                                    <option value="NEWEST">日付: 新しい順</option>
                                    <option value="OLDEST">日付: 古い順</option>
                                    <option value="HEIGHT_DESC">草丈: 高い順</option>
                                </select>
                            </div>
                        </div>

                        <!-- Data List Container -->
                        <div id="records-list" class="space-y-3 max-h-[420px] overflow-y-auto custom-scrollbar pr-1">
                            <!-- Populated dynamically via JS -->
                        </div>
                    </div>
                </div>
            </div>
        </section>


        <!-- TAB 2: マイ作物紹介サイト (vegetable) ジェネレーター -->
        <section id="tab-vegetable" class="tab-content hidden space-y-6">
            
            <!-- Banner Header -->
            <div class="bg-gradient-to-r from-amber-700 to-orange-600 rounded-2xl p-6 text-white shadow-lg relative overflow-hidden">
                <div class="relative z-10 max-w-3xl">
                    <div class="inline-flex items-center space-x-2 px-3 py-1 bg-white/10 backdrop-blur-md rounded-full text-xs text-amber-200 mb-3 border border-white/20">
                        <i class="fa-solid fa-star"></i> 課題2完全攻略：GitHub Pages + HTML/CSS/JS (vegetable)
                    </div>
                    <h2 class="text-2xl sm:text-3xl font-bold mb-2">マイ作物 紹介サイトジェネレーター</h2>
                    <p class="text-amber-100 text-sm leading-relaxed mb-4">
                        採点条件1〜10（大見出し、特徴3文、栽培ポイント3つ、表、画像、CSS、西条農業高校ボタン、外部栽培サイトボタン）を100%自動クリアするサイトを作成しプレビュー・コード生成ができます。
                    </p>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                
                <!-- Left: Web Page Builder Settings -->
                <div class="lg:col-span-5 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4 max-h-[800px] overflow-y-auto custom-scrollbar">
                    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                        <h3 class="font-bold text-slate-800 text-base flex items-center">
                            <i class="fa-solid fa-sliders text-amber-600 mr-2"></i> サイト構成データの設定
                        </h3>
                        <span class="text-xs bg-amber-100 text-amber-800 px-2 py-0.5 rounded-full font-bold">100点仕様基準</span>
                    </div>

                    <!-- Crop Select & Customizer -->
                    <div class="space-y-3">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">メイン作物名 (条件1: 大見出し)</label>
                            <input type="text" id="v-title" value="甘くておいしい「ミニトマト」" oninput="updateVegetablePreview()" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm">
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">作物の特徴の説明文 (条件2: 3文以上)</label>
                            <textarea id="v-desc" rows="3" oninput="updateVegetablePreview()" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs">ミニトマトは家庭菜園でも大人気のビタミン豊富なお野菜です。日当たりの良い場所で育てることで甘みが増し、たくさんの実を収穫できます。初心者でも比較的育てやすく、毎日の観察がとても楽しい作物です。</textarea>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">栽培のポイント (条件3: 箇条書き3つ以上)</label>
                            <div class="space-y-1.5">
                                <input type="text" id="v-p1" value="日当たりと風通しの良い場所で管理する" oninput="updateVegetablePreview()" class="w-full px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs">
                                <input type="text" id="v-p2" value="脇芽（わきめ）を早めにつみ取って栄養を集中させる" oninput="updateVegetablePreview()" class="w-full px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs">
                                <input type="text" id="v-p3" value="水やりは土の表面が乾いてからたっぷりと与える" oninput="updateVegetablePreview()" class="w-full px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs">
                            </div>
                        </div>

                        <!-- Table Information -->
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">栽培基本情報 (条件4: 表 table)</label>
                            <div class="grid grid-cols-3 gap-2">
                                <input type="text" id="v-sow" value="4月〜5月" oninput="updateVegetablePreview()" placeholder="種まき時期" class="px-2 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs">
                                <input type="text" id="v-harvest" value="6月〜8月" oninput="updateVegetablePreview()" placeholder="収穫時期" class="px-2 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs">
                                <input type="text" id="v-diff" value="★☆☆ (簡単)" oninput="updateVegetablePreview()" placeholder="難易度" class="px-2 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs">
                            </div>
                        </div>

                        <!-- Image URL -->
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">画像URL (条件5: 画像1枚以上)</label>
                            <input type="text" id="v-img" value="https://images.unsplash.com/photo-1592841200221-a6898f307baa?auto=format&fit=crop&w=800&q=80" oninput="updateVegetablePreview()" class="w-full px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs">
                        </div>

                        <!-- Required External Buttons -->
                        <div class="p-3 bg-amber-50 rounded-xl border border-amber-200 space-y-2">
                            <span class="text-xs font-bold text-amber-900 block"><i class="fa-solid fa-link"></i> 指定ボタンリンク設定</span>
                            <div>
                                <label class="block text-[11px] text-slate-600">ボタン①: 西条農業高校サイト URL (条件7)</label>
                                <input type="text" id="v-btn1-url" value="https://saijo-ah.esnet.ed.jp/" oninput="updateVegetablePreview()" class="w-full px-2.5 py-1 bg-white border border-slate-300 rounded text-xs">
                            </div>
                            <div>
                                <label class="block text-[11px] text-slate-600">ボタン②: 外部栽培方法サイト URL (条件8: サカタのタネ等)</label>
                                <input type="text" id="v-btn2-url" value="https://www.sakataseed.co.jp/" oninput="updateVegetablePreview()" class="w-full px-2.5 py-1 bg-white border border-slate-300 rounded text-xs">
                            </div>
                        </div>

                        <!-- Bonus Features Checkboxes -->
                        <div class="p-3 bg-slate-100 rounded-xl space-y-1.5 text-xs">
                            <span class="font-bold text-slate-700 block mb-1"><i class="fa-solid fa-circle-plus text-emerald-600"></i> 加点機能の設定 (+40点分)</span>
                            <label class="flex items-center space-x-2">
                                <input type="checkbox" id="bonus-js" checked onchange="updateVegetablePreview()" class="rounded text-amber-600">
                                <span>JS動き効果 (ボタンクリックでメッセージ＆色変化 / +10点)</span>
                            </label>
                            <label class="flex items-center space-x-2">
                                <input type="checkbox" id="bonus-multi" checked onchange="updateVegetablePreview()" class="rounded text-amber-600">
