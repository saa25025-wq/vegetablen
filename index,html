            onSnapshot(colRef, (snapshot) => {
                recordsData = snapshot.docs.map(docSnap => ({
                    id: docSnap.id,
                    ...docSnap.data()
                }));
                window.recordsData = recordsData;
                updateCropFilter();
                renderPlantList();
                updateChart();
                document.getElementById('sync-status').innerHTML = '<i class="fa-solid fa-cloud-check text-emerald-400 mr-1"></i> Firestore同期完了';
            }, (error) => {
                console.error("Firestore sync fallback to LocalStorage:", error);
                document.getElementById('sync-status').innerHTML = '<i class="fa-solid fa-hard-drive text-amber-300 mr-1"></i> ローカル保存モード';
                loadLocalStorage();
            });
        }

        function loadLocalStorage() {
            const local = localStorage.getItem('plantcheck_purant_records');
            recordsData = local ? JSON.parse(local) : [];
            window.recordsData = recordsData;
            updateCropFilter();
            renderPlantList();
            updateChart();
        }

        window.savePlantRecord = async function(data, editId) {
            const appId = typeof __app_id !== 'undefined' ? __app_id : 'plantcheck-default';
            try {
                if (editId) {
                    const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'records', editId);
                    await updateDoc(docRef, data);
                } else {
                    const colRef = collection(db, 'artifacts', appId, 'public', 'data', 'records');
                    await addDoc(colRef, { ...data, createdAt: Date.now() });
                }
            } catch (err) {
                // LocalStorage Fallback
                if (editId) {
                    const idx = recordsData.findIndex(r => r.id === editId);
                    if (idx !== -1) recordsData[idx] = { id: editId, ...data };
                } else {
                    recordsData.unshift({ id: Date.now().toString(), ...data });
                }
                localStorage.setItem('plantcheck_purant_records', JSON.stringify(recordsData));
                updateCropFilter();
                renderPlantList();
                updateChart();
            }
        };

        window.deletePlantRecord = async function(id) {
            if (!confirm('削除してもよろしいですか？')) return;
            const appId = typeof __app_id !== 'undefined' ? __app_id : 'plantcheck-default';
            try {
                await deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'records', id));
            } catch (err) {
                recordsData = recordsData.filter(r => r.id !== id);
                localStorage.setItem('plantcheck_purant_records', JSON.stringify(recordsData));
                updateCropFilter();
                renderPlantList();
                updateChart();
            }
        };

        // Initialize Chart
        const ctx = document.getElementById('appChart').getContext('2d');
        chartInstance = new Chart(ctx, {
            type: 'line',
            data: { labels: [], datasets: [{ label: '草丈 (cm)', data: [], borderColor: '#10b981', backgroundColor: 'rgba(16, 185, 129, 0.1)', fill: true, tension: 0.3 }] },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { ticks: { font: { size: 9 } } }, y: { ticks: { font: { size: 9 } } } } }
        });

        window.updateChart = function() {
            if (!chartInstance || !recordsData) return;
            const sorted = [...recordsData].sort((a,b) => new Date(a.date) - new Date(b.date));
            chartInstance.data.labels = sorted.map(r => r.date);
            chartInstance.data.datasets[0].data = sorted.map(r => r.height);
            chartInstance.update();
        };
    <\/script>

